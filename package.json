{
  "name": "smart-youtube-comment",
  "version": "0.1.0",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "security": "node scripts/security-check.mjs && npm audit --omit=dev",
    "security:bun": "bun scripts/security-check.mjs && npm audit --omit=dev",
    "test": "node scripts/test.mjs",
    "test:bun": "bun scripts/test.mjs",
    "coverage": "node scripts/coverage.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix worker run typecheck",
    "build": "node scripts/build-web.mjs",
    "deploy:web": "node scripts/deploy-web.mjs",
    "deploy:worker": "npm --prefix worker run deploy",
    "format": "prettier --write \"web/**/*.{ts,js,mjs}\" \"worker/**/*.{ts,js,mjs}\" \"bench/**/*.mjs\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"web/**/*.{ts,js,mjs}\" \"worker/**/*.{ts,js,mjs}\" \"bench/**/*.mjs\" \"scripts/*.mjs\"",
    "test:e2e": "node bench/e2e/perf.mjs",
    "test:e2e:bun": "bun bench/e2e/perf.mjs",
    "test:sandbox": "node scripts/check-sandbox.mjs",
    "test:sandbox:bun": "bun scripts/check-sandbox.mjs",
    "release:check": "npm run security && npm test",
    "release:check:bun": "bun run security:bun && bun run test:bun",
    "release:zip": "npm run release:check && node scripts/package-extension.mjs",
    "release:zip:bun": "bun run release:check:bun && bun scripts/package-extension.mjs",
    "release:store:assets": "node scripts/generate-store-assets.mjs",
    "release:store:status": "node scripts/chrome-webstore.mjs status",
    "release:store:upload": "node scripts/chrome-webstore.mjs upload",
    "release:store:publish": "node scripts/chrome-webstore.mjs publish",
    "release:store:submit": "node scripts/chrome-webstore.mjs submit",
    "release:store": "npm run release:zip && npm run release:store:submit",
    "sandbox": "node scripts/serve-sandbox.mjs",
    "sandbox:bun": "bun scripts/serve-sandbox.mjs",
    "version:set": "node scripts/set-version.mjs",
    "version:set:bun": "bun scripts/set-version.mjs",
    "test:ext": "node bench/e2e/extension.mjs",
    "test:ext:bun": "bun bench/e2e/extension.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "playwright": "1.60.0",
    "prettier": "3.9.4",
    "typescript": "5.7.2",
    "wrangler": "4.107.0"
  }
}
